{
  "name": "lifeline",
  "private": true,
  "version": "0.2.0",
  "description": "Desktop resupply planner: truck, drone and airdrop options on real terrain, OpenStreetMap roads, weather and Sentinel-2 flood detection",
  "keywords": [
    "humanitarian-logistics",
    "disaster-response",
    "resupply",
    "airdrop",
    "drone-delivery",
    "route-planning",
    "flood-mapping",
    "sentinel-2",
    "openstreetmap",
    "tauri"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sekaikx/lifeline"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@tauri-apps/api": "^2.12.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.186.1",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.7"
  }
}
